{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/products/neocell/pure/",
      "destination": "/products/neocell-pure/",
      "permanent": true
    },
    {
      "source": "/products/neocell/pure/:path*",
      "destination": "/products/neocell-pure/:path*",
      "permanent": true
    }
  ]
}
